{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run db:generate && npm run build",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "packages/db/generated/**"
    }
  },
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/index"},
    {"source":"/socket.io/:path*","destination":"/api/index"},
    {"source":"/health/:path*","destination":"/api/index"},
    {"source":"/((?!assets/|favicon.svg).*)","destination":"/index.html"}
  ],
  "daemons": {
    "worker": {"root":".","entrypoint":"infra/worker.Dockerfile","instances":{"bom1":1}}
  }
}
