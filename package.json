{
  "name": "devcollab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/api/src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "vitest run",
    "email:check": "tsx scripts/email-check.ts",
    "eval:ai": "tsx scripts/ai-evaluation.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "contracts": "tsx scripts/openapi.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "local:setup": "tsx scripts/local-setup.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "local:db": "tsx scripts/local-postgres.ts",
    "local:unicode": "tsx scripts/local-unicode.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/prisma-adapter": "1.7.10",
    "@fontsource/geist": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@gsap/react": "2.1.2",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "@tanstack/react-query": "5.104.4",
    "@xmldom/xmldom": "0.9.12",
    "better-auth": "1.7.10",
    "bullmq": "6.3.16",
    "dompurify": "3.4.17",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "gsap": "3.15.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "lucide-react": "1.59.0",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "multer": "2.4.0",
    "nodemailer": "10.1.2",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
